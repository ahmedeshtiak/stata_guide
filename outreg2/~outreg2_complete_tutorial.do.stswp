/*=============================================================================
  COMPLETE OUTREG2 TUTORIAL FOR STATA
  Using a Simulated Large-Scale RCT Household Survey Dataset
  
  Author  : Tutorial by Ahmed Eshtiak | BIGD, BRAC University
  Purpose : In-depth mastery of outreg2 — every option, every use case
  Data    : Simulated RCT HH Survey — 5,000 households, 3 districts,
            treatment/control arms, baseline + endline structure
            
  SECTIONS:
  Part 0  — Install outreg2 (if needed)
  Part 1  — Generate Simulated RCT Household Survey Dataset
  Part 2  — outreg2 Fundamentals: Basic Syntax & Structure
  Part 3  — OLS Regressions: Single, Multiple, Adding Variables
  Part 4  — Robust & Clustered Standard Errors
  Part 5  — Fixed Effects (areg, xtreg, reghdfe)
  Part 6  — IV / 2SLS with ivreg2
  Part 7  — Binary Outcomes: Probit & Logit
  Part 8  — Formatting Tables (stars, labels, stats, decimals)
  Part 9  — Multi-equation / Side-by-Side Model Columns
  Part 10 — Subgroup / Heterogeneous Treatment Effects
  Part 11 — Word (.doc) and TeX output
  Part 12 — Advanced: ctitle, addtext, addstat, keep, drop, order
  Part 13 — Common Pitfalls & Debugging Tips
=============================================================================*/

clear all
set more off
set seed 20250601          // reproducible randomness
capture log close
cd "D:\Ahmed Eshtiak\Local Disk D\STATA Github\stata_guide\outreg2"

***************************************************
**# GENERATE SIMULATED RCT HOUSEHOLD SURVEY DATASET
***************************************************

/*=============================================================================
  Design:
  - 5,000 households (hhid)
  - 3 districts (district): Dhaka, Rajshahi, Khulna
  - 6 upazilas per district → 18 upazilas total
  - ~5-6 villages per upazila → ~90 villages
  - Treatment assigned at VILLAGE level (cluster RCT)
  - ~50% treatment rate at village level
  - Baseline characteristics + Endline outcomes
  - Realistic effect sizes from graduation programs
=============================================================================*/

* Build village-level treatment assignment 
clear
set obs 90

gen village_id   = _n
gen district_id  = ceil(village_id / 30)      // 30 villages per district
gen upazila_id   = ceil(village_id / 5)        // 5 villages per upazila

* Treatment: randomise at village level
gen treat = (runiform() > 0.50)               // ~50% treated villages

* Village-level contextual variables (affect outcomes)
gen vill_market_dist   = 2 + 8*runiform()     // km to nearest market
gen vill_flood_risk    = rbinomial(1, 0.35)   // flood-prone area
gen vill_poverty_rate  = 0.30 + 0.35*runiform()

label var village_id  "Village ID (1–90)"
label var district_id "District (1=Dhaka 2=Rajshahi 3=Khulna)"
label var upazila_id "Upazila ID (1–18)"
label var treat             "Treatment Village (1=Yes)"
label var vill_market_dist "Distance to nearest market (km)"
label var vill_flood_risk "Flood-prone village (1=Yes)"
label var vill_poverty_rate "Village-level poverty rate"

save "village_level.dta", replace

* Generate household-level data 
clear
set obs 5000

gen hhid = _n

* Assign each HH to a village (roughly equal HHs per village)
gen village_id = ceil(hhid / ceil(5000/90))
replace village_id = 90 if village_id > 90   // trim edge case

* Merge in village-level variables
merge m:1 village_id using "village_level.dta", nogen

* Household Identifiers & Strata 
gen district = district_id
gen upazila  = upazila_id

label define district_lbl 1 "Dhaka" 2 "Rajshahi" 3 "Khulna"
label values district district_lbl

* Household Demographics (BASELINE) 
gen hh_size       = 3 + int(4*runiform())  // 3–6 members
gen hh_female_hh  = rbinomial(1, 0.55)    // female-headed HH
gen hh_age_head   = 25 + int(40*runiform()) // age 25–65
gen hh_edu_head   = 0 + int(8*runiform()) // 0–7 years education
gen hh_muslim     = rbinomial(1, 0.90) // religion
gen hh_land_owned = max(0, rnormal(0.15, 0.20)) // acres (skewed)

* Baseline asset index (latent wealth, used to generate outcomes)
gen asset_index_bl = rnormal(0, 1)
* Poorer HHs slightly more likely to be in treatment (imperfect targeting)
replace asset_index_bl = asset_index_bl - 0.05*treat + rnormal(0, 0.1)

* BASELINE OUTCOME VARIABLES 
* Monthly per-capita consumption (BDT)
gen pce_bl = max(500, 1500 + 400*asset_index_bl - 50*hh_female_hh + 20*hh_edu_head + 100*vill_flood_risk*(-1) + rnormal(0, 300))

* Monthly income (BDT)
gen income_bl = max(200, 2000 + 500*asset_index_bl - 80*hh_female_hh + 30*hh_edu_head  + rnormal(0, 400))

* Food expenditure (BDT/month)
gen food_exp_bl = max(400, 1200 + 300*asset_index_bl  + rnormal(0, 200))

* Employment (days worked last month)
gen days_work_bl = max(0, round(15 + 5*asset_index_bl - 3*hh_female_hh + rnormal(0, 5)))

* Savings (BDT)
gen savings_bl = max(0, 500 + 800*asset_index_bl + rnormal(0, 400))

* Food security score (0–8)
gen food_sec_bl = max(0, min(8, round(4 + 1.5*asset_index_bl - 0.5*vill_flood_risk + rnormal(0, 1))))

* Child school enrolment (1=all children enrolled)
gen child_school_bl = rbinomial(1, 0.60 + 0.10*(asset_index_bl > 0))

* Women's empowerment index (0–10)
gen women_emp_bl = max(0, min(10, round(5 + 1.2*asset_index_bl + 0.5*hh_female_hh + rnormal(0, 1.5))))

* Health expenditure (BDT/month)
gen health_exp_bl = max(0, 200 + 150*asset_index_bl + rnormal(0, 150))

* TREATMENT EFFECTS (Endline)
/*
  Program effects (realistic graduation RCT estimates):
  - Income:           +BDT 450 (~20% of baseline mean)
  - PCE:              +BDT 200 (~13%)
  - Food expenditure: +BDT 150 (~12%)
  - Days worked:      +2 days (~13%)
  - Savings:          +BDT 300 (~40%)
  - Food security:    +0.5 points
  - Child school:     +8pp
  - Women empowerment:+0.8 points
  - Health exp:       +BDT 80 (~33%)
  These are additive on top of secular trend (growth for all)
*/

gen ate_income = 450
gen ate_pce = 200
gen ate_food = 150
gen ate_work = 2
gen ate_savings = 300
gen ate_foodsec = 0.5
gen ate_school = 0.08
gen ate_womemp = 0.8
gen ate_health  = 80

* ── ENDLINE OUTCOME VARIABLES ────────────────────────────────────────────────
* Endline = baseline + secular growth (10%) + treatment effect + noise

gen income_el = income_bl * 1.10  + ate_income * treat + rnormal(0, 400)
replace income_el = max(200, income_el)

gen pce_el = pce_bl * 1.10 + ate_pce * treat + rnormal(0, 300)
replace pce_el = max(500, pce_el)

gen food_exp_el = food_exp_bl * 1.08 + ate_food * treat  + rnormal(0, 200)
replace food_exp_el = max(400, food_exp_el)

gen days_work_el = days_work_bl + ate_work * treat  + rnormal(0, 4)
replace days_work_el = max(0, round(days_work_el))

gen savings_el = max(0, savings_bl * 1.05 + ate_savings * treat)

gen food_sec_el  = food_sec_bl + ate_foodsec * treat  + rnormal(0, 0.8)
replace food_sec_el = max(0, min(8, round(food_sec_el)))

gen child_school_el = child_school_bl
replace child_school_el = 1 if runiform() < (0.60 + ate_school*treat + 0.08*asset_index_bl)
replace child_school_el = 0 if child_school_el == . 

gen women_emp_el = women_emp_bl + ate_womemp * treat + rnormal(0, 1.2)
replace women_emp_el = max(0, min(10, women_emp_el))

gen health_exp_el = health_exp_bl + ate_health * treat + rnormal(0, 120)
replace health_exp_el = max(0, health_exp_el)

*  CLIMATE VULNERABILITY INDEX (for HTE section) 
gen climate_vuln = vill_flood_risk * 0.6 + (vill_market_dist > 7) * 0.25 + rnormal(0, 0.1)
replace climate_vuln = min(1, max(0, climate_vuln))

* High vs low climate vulnerability binary
gen high_climate_vuln = (climate_vuln > 0.35)

* PANEL IDENTIFIER (long format)
gen wave = 1    // baseline = 1; endline = 2 (wide format here)

* ── LABELS ─────────────────────────────────────────────────────────────────
label var hhid "Household ID"
label var treat "Treatment Indicator (1=Treated)"
label var district "District"
label var upazila "Upazila ID"
label var village_id "Village ID"
label var hh_size "Household Size"
label var hh_female_hh "Female-Headed Household (1=Yes)"
label var hh_age_head "Age of Household Head (years)"
label var hh_edu_head "Education of Head (years)"
label var hh_muslim "Muslim Household (1=Yes)"
label var hh_land_owned "Land Owned (acres)"
label var asset_index_bl "Baseline Asset Index (std.)"
label var pce_bl "PCE Baseline (BDT/month)"
label var pce_el "PCE Endline (BDT/month)"
label var income_bl "Income Baseline (BDT/month)"
label var income_el "Income Endline (BDT/month)"
label var food_exp_bl "Food Expenditure Baseline (BDT)"
label var food_exp_el "Food Expenditure Endline (BDT)"
label var days_work_bl "Days Worked Baseline (days/month)"
label var days_work_el "Days Worked Endline (days/month)"
label var savings_bl "Savings Baseline (BDT)"
label var savings_el "Savings Endline (BDT)"
label var food_sec_bl "Food Security Score Baseline (0–8)"
label var food_sec_el "Food Security Score Endline (0–8)"
label var child_school_bl "Child School Enrolment Baseline (1=Yes)"
label var child_school_el "Child School Enrolment Endline (1=Yes)"
label var women_emp_bl "Women's Empowerment Baseline (0–10)"
label var women_emp_el "Women's Empowerment Endline (0–10)"
label var health_exp_bl "Health Expenditure Baseline (BDT)"
label var health_exp_el "Health Expenditure Endline (BDT)"
label var climate_vuln "Climate Vulnerability Index (0–1)"
label var high_climate_vuln "High Climate Vulnerability (1=Yes)"
label var vill_flood_risk "Flood-Prone Village (1=Yes)"
label var vill_market_dist "Distance to Market (km)"

save "rct_hh_survey.dta", replace

tabulate treat district, col nofreq
summarize income_el pce_el food_exp_el days_work_el savings_el


/*=============================================================================
  PART 2 — outreg2 FUNDAMENTALS: BASIC SYNTAX & STRUCTURE
  
  Full syntax reference:
  
  outreg2 [varlist] using "filename.xls",  ///
      [replace/append]                     ///  file options
      [ctitle("Column Title")]             ///  column header
      [addstat("Label", expr, ...)]        ///  add custom stats rows
      [addtext("Label", "Value", ...)]     ///  add custom text rows  
      [keep(varlist) / drop(varlist)]      ///  show/hide coefficients
      [sortvar(varlist)]                   ///  reorder rows
      [stats(coef se t pvalue ci)]         ///  what to show below coef
      [dec(#) / bdec(#) / sdec(#)]        ///  decimal places
      [nocons]                             ///  hide constant
      [label]                              ///  use variable labels
      [excel / word / tex]                 ///  output format
      [nonotes]                            ///  suppress default notes
      [alpha(# # #) symbol(* ** ***)]      ///  significance stars
      [e(list)]                            ///  e() scalars to include
      
  KEY OPERATORS:
  - replace  : overwrite existing file (first model)
  - append   : add column to existing table (subsequent models)
  - using    : specifies output filename
  
  After ANY estimation command (regress, probit, ivreg2, xtreg, etc.),
  outreg2 reads stored e() results and writes them to a table.
=============================================================================*/


******************
**# OUTREG2 Basics
******************	
use "rct_hh_survey.dta", clear

regress income_el treat
outreg2 using "basic.xls", replace


/*
  What this produces:
  - Excel file "part2_basic.xls"
  - One column of results
  - Coefficient on treat + constant
  - Standard error in parentheses below each coef
  - Stars (*** ** *) based on p-values
  - N, R-squared at the bottom
*/

*************************************************
**# Multi column table (More than One Regression)
*************************************************

* Model 1: treatment only
regress income_el treat
outreg2 using "multiple_column.xls", replace ctitle ("No Control") label nocons addtext ("District FE", "No", "Covariates", "No", "SE Clustered", "No") // nocons hides the constant; addtext adds custom rows: District FE = No, Covariates = No


* Model 2: Add household controls 
regress income_el treat hh_size hh_female_hh hh_age_head hh_edu_head hh_land_owned
outreg2 using "multiple_column.xls", append ctitle ("With Control") label nocons addtext ("District FE", "No", "Covariates", "Yes", , "SE Clustered", "No") // append the regression with control to the next column 


* Model 3: district FE 
regress income_el treat hh_size hh_female_hh hh_age_head hh_edu_head hh_land_owned i.district
outreg2 using "multiple_column.xls", append ctitle ("District FE") drop(*.district) label nocons addtext ("District FE", "Yes", "Covariates", "Yes", "SE Clustered", "No") //// drop(*.district) to hide district dummy coefficients

* Model 4: Control + FE + SE Clustered at Village

regress income_el treat hh_size hh_female_hh hh_age_head hh_edu_head hh_land_owned i.district, vce(cluster village_id)
outreg2 using "multiple_column.xls", append ctitle (SE Clustered) drop (*.district) label nocons addtext ("District FE", "Yes", "Covariates", "Yes", "SE Clustered", "Village")


*************************************************
**# Same Regression Showing P-Value
*************************************************

* Model 1: treatment only
regress income_el treat
outreg2 using "multiple_column.xls", replace ctitle ("No Control") label nocons stats (coef pval) addtext ("District FE", "No", "Covariates", "No", "SE Clustered", "No") // nocons hides the constant; addtext adds custom rows: District FE = No, Covariates = No


* Model 2: Add household controls 
regress income_el treat hh_size hh_female_hh hh_age_head hh_edu_head hh_land_owned
outreg2 using "multiple_column.xls", append ctitle ("With Control") label nocons stats (coef pval) addtext ("District FE", "No", "Covariates", "Yes", , "SE Clustered", "No") // append the regression with control to the next column 


* Model 3: district FE 
regress income_el treat hh_size hh_female_hh hh_age_head hh_edu_head hh_land_owned i.district
outreg2 using "multiple_column.xls", append ctitle ("District FE") drop(*.district) label nocons stats (coef pval) addtext ("District FE", "Yes", "Covariates", "Yes", "SE Clustered", "No") //// drop(*.district) to hide district dummy coefficients

* Model 4: Control + FE + SE Clustered at Village
regress income_el treat hh_size hh_female_hh hh_age_head hh_edu_head hh_land_owned i.district, vce(cluster village_id)
outreg2 using "multiple_column.xls", append ctitle (SE Clustered) drop (*.district) label nocons stats (coef pval) addtext ("District FE", "Yes", "Covariates", "Yes", "SE Clustered", "Village")


******************
**# Binary Outcome
******************

* Model 1: LPM
regress child_school_el treat hh_size hh_female_hh hh_age_head hh_edu_head hh_land_owned i.district, vce(cluster village_id)
outreg2 using "binary.xls", replace ctitle (LPM) drop (*.district) label nocons addtext ("District FE", "Yes", "Covariates", "Yes", "SE Clustered", "Village")

* Model 2: Probit
probit child_school_el treat hh_size hh_female_hh hh_age_head hh_edu_head hh_land_owned i.district, vce(cluster village_id)
outreg2 using "binary.xls", append ctitle (Probit) drop (*.district) label nocons addtext ("District FE", "Yes", "Covariates", "Yes", "SE Clustered", "Village")

* Model 3: Probit With AME
probit child_school_el treat hh_size hh_female_hh hh_age_head hh_edu_head hh_land_owned i.district, vce(cluster village_id)
margins, dydx(*) post
outreg2 using "binary.xls", append ctitle (Probit With AME) drop (*.district) label nocons addtext ("District FE", "Yes", "Covariates", "Yes", "SE Clustered", "Village")

* Model 4: Logistic
logistic child_school_el treat hh_size hh_female_hh hh_age_head hh_edu_head hh_land_owned i.district, vce(cluster village_id)
outreg2 using "binary.xls", append ctitle (Logistic) drop (*.district) label nocons addtext ("District FE", "Yes", "Covariates", "Yes", "SE Clustered", "Village")


*********************************
**# Adding Summary Stats and Notes
**********************************
regress income_el treat hh_size hh_female_hh hh_age_head hh_edu_head hh_land_owned i.district, vce(cluster village_id)
outreg2 using "sumstat_notes.xls", append ctitle (SE Clustered) drop (*.district) label nocons addstat("Adj. R-sq", e(r2_a), "F-statistic", e(F), "RMSE", e(rmse))  addtext ("District FE", "Yes", "Covariates", "Yes", "SE Clustered", "Village") addnote("Standard errors clustered at village level.", "*** p<0.01 ** p<0.05 * p<0.1")



















* ─
/*=============================================================================
  PART 9 — MULTI-OUTCOME TABLES (side-by-side dependent variables)
  
  Common in RCT papers: one table with treatment effect on many outcomes.
  Each COLUMN = different outcome variable.
  The treatment row shows the ATE on each outcome.
=============================================================================*/

di "=== PART 9: Multi-outcome (multiple DV) table ==="

* Full specification: ANCOVA with district FE + clustered SE
* Run for each outcome, append each into same file

local outcomes "income_el pce_el food_exp_el days_work_el savings_el food_sec_el"
local baselines "income_bl pce_bl food_exp_bl days_work_bl savings_bl food_sec_bl"
local labels "(1) Income" "(2) PCE" "(3) Food Exp" "(4) Days Worked" "(5) Savings" "(6) Food Security"
local nout = 6

* Delete file if it exists, so we start fresh
capture erase "part9_multioutcome.xls"

forvalues i = 1/`nout' {
    local ov : word `i' of `outcomes'
    local bv : word `i' of `baselines'
    local lbl: word `i' of `labels'
    
    regress `ov' treat `bv' hh_size hh_female_hh                ///
            hh_age_head hh_edu_head hh_land_owned i.district,   ///
            vce(cluster village_id)
    
    * First model: replace; subsequent models: append
    if `i' == 1 {
        outreg2 using "part9_multioutcome.xls",                ///
            replace                                             ///
            ctitle("`lbl'")                                    ///
            label nocons keep(treat `bv')                      ///
            drop(*.district)                                   ///
            addtext("District FE","Yes","Covariates","Yes")    ///
            nonotes                                            ///
            addnote("SEs clustered at village level.",         ///
                    "* p<0.1 ** p<0.05 *** p<0.01")
    }
    else {
        outreg2 using "part9_multioutcome.xls",                ///
            append                                              ///
            ctitle("`lbl'")                                    ///
            label nocons keep(treat `bv')                      ///
            drop(*.district)                                   ///
            addtext("District FE","Yes","Covariates","Yes")    ///
            nonotes
    }
}

/*
  NOTE ON LOOPS:
  A loop is used here ONLY to illustrate the pattern.
  In actual RCT papers, you often want each regression typed out
  individually so you can customise each column (different controls,
  different notes). The underlying outreg2 logic is identical:
  first → replace, all subsequent → append.
*/

di "Table saved: part9_multioutcome.xls (6 outcomes)"


/*=============================================================================
  PART 10 — HETEROGENEOUS TREATMENT EFFECTS (HTE)
  
  Interaction model:  Y = α + β₁ T + β₂ M + β₃ (T×M) + X'γ + ε
  β₁ = ATE for M=0 group
  β₃ = DIFFERENTIAL effect for M=1 group
  (β₁ + β₃) = ATE for M=1 group
  
  Moderators tested here:
  - Female-headed households (hh_female_hh)
  - High climate vulnerability (high_climate_vuln)
=============================================================================*/

di "=== PART 10: Heterogeneous Treatment Effects ==="

* ── Generate interaction terms ───────────────────────────────────────────────
gen treat_x_female  = treat * hh_female_hh
gen treat_x_climate = treat * high_climate_vuln

label var treat_x_female  "Treat × Female HH"
label var treat_x_climate "Treat × High Climate Vuln"

* ── Subgroup 1: By female HH status ─────────────────────────────────────────
regress income_el treat hh_female_hh treat_x_female             ///
        income_bl hh_size hh_age_head hh_edu_head               ///
        hh_land_owned i.district,                               ///
        vce(cluster village_id)

outreg2 using "part10_hte.xls",                                ///
    replace                                                     ///
    ctitle("(1) Income: Female HH HTE")                        ///
    label nocons                                               ///
    keep(treat hh_female_hh treat_x_female income_bl)         ///
    drop(*.district)                                           ///
    addtext("District FE","Yes","Moderator","Female HH")       ///
    nonotes                                                    ///
    addnote("SEs clustered at village. * p<0.1 ** p<0.05 *** p<0.01")

* ── Subgroup 2: By climate vulnerability ────────────────────────────────────
regress income_el treat high_climate_vuln treat_x_climate        ///
        income_bl hh_size hh_female_hh hh_age_head hh_edu_head  ///
        hh_land_owned i.district,                               ///
        vce(cluster village_id)

outreg2 using "part10_hte.xls",                                ///
    append                                                      ///
    ctitle("(2) Income: Climate HTE")                          ///
    label nocons                                               ///
    keep(treat high_climate_vuln treat_x_climate income_bl)   ///
    drop(*.district)                                           ///
    addtext("District FE","Yes","Moderator","Climate Vuln")    ///
    nonotes

* ── Repeat for PCE outcome ───────────────────────────────────────────────────
regress pce_el treat hh_female_hh treat_x_female                ///
        pce_bl hh_size hh_age_head hh_edu_head                  ///
        hh_land_owned i.district,                               ///
        vce(cluster village_id)

outreg2 using "part10_hte.xls",                                ///
    append                                                      ///
    ctitle("(3) PCE: Female HH HTE")                           ///
    label nocons                                               ///
    keep(treat hh_female_hh treat_x_female pce_bl)            ///
    drop(*.district)                                           ///
    addtext("District FE","Yes","Moderator","Female HH")       ///
    nonotes

regress pce_el treat high_climate_vuln treat_x_climate           ///
        pce_bl hh_size hh_female_hh hh_age_head hh_edu_head     ///
        hh_land_owned i.district,                               ///
        vce(cluster village_id)

outreg2 using "part10_hte.xls",                                ///
    append                                                      ///
    ctitle("(4) PCE: Climate HTE")                             ///
    label nocons                                               ///
    keep(treat high_climate_vuln treat_x_climate pce_bl)      ///
    drop(*.district)                                           ///
    addtext("District FE","Yes","Moderator","Climate Vuln")    ///
    nonotes

di "Table saved: part10_hte.xls"


/*=============================================================================
  PART 11 — WORD (.doc) AND LATEX (.tex) OUTPUT
  
  outreg2 can write to three formats:
  (a) Excel (.xls)  → default, easiest for copy-paste into Word
  (b) Word  (.doc)  → native Word table, ready to submit
  (c) LaTeX (.tex)  → for LaTeX manuscripts
=============================================================================*/

di "=== PART 11: Word and LaTeX output ==="

* ── 11a: Word output ─────────────────────────────────────────────────────────
regress income_el treat income_bl hh_size hh_female_hh           ///
        hh_age_head hh_edu_head hh_land_owned i.district,        ///
        vce(cluster village_id)

outreg2 using "part11_table.doc",                              ///
    replace                                                     ///
    word                                                        ///
    ctitle("(1) Income")                                       ///
    label nocons keep(treat income_bl)                         ///
    drop(*.district)                                           ///
    addtext("District FE","Yes")                               ///
    title("Table: Treatment Effects on Household Income")

regress pce_el treat pce_bl hh_size hh_female_hh                 ///
        hh_age_head hh_edu_head hh_land_owned i.district,        ///
        vce(cluster village_id)

outreg2 using "part11_table.doc",                              ///
    append                                                      ///
    word                                                        ///
    ctitle("(2) PCE")                                          ///
    label nocons keep(treat pce_bl)                            ///
    drop(*.district)                                           ///
    addtext("District FE","Yes")

/*
  OPTIONS SPECIFIC TO WORD:
  word           → forces .doc output (also auto-detected from .doc extension)
  title("...")   → adds a table title at the top
*/

* ── 11b: LaTeX output ────────────────────────────────────────────────────────
regress income_el treat income_bl hh_size hh_female_hh           ///
        hh_age_head hh_edu_head hh_land_owned i.district,        ///
        vce(cluster village_id)

outreg2 using "part11_table.tex",                              ///
    replace                                                     ///
    tex(frag)                                                   ///
    ctitle("(1) Income")                                       ///
    label nocons keep(treat income_bl)                         ///
    drop(*.district)                                           ///
    addtext("District FE","Yes")                               ///
    title("Treatment Effects on Household Outcomes")

regress pce_el treat pce_bl hh_size hh_female_hh                 ///
        hh_age_head hh_edu_head hh_land_owned i.district,        ///
        vce(cluster village_id)

outreg2 using "part11_table.tex",                              ///
    append                                                      ///
    tex(frag)                                                   ///
    ctitle("(2) PCE")                                          ///
    label nocons keep(treat pce_bl)                            ///
    drop(*.district)                                           ///
    addtext("District FE","Yes")

/*
  tex(frag) → outputs a LaTeX fragment (just the tabular environment)
              ready to \input{} into your paper's .tex file
  tex(pr)   → outputs a complete LaTeX document (can compile standalone)
  
  To include in paper:   \input{part11_table.tex}
*/

di "Files saved: part11_table.doc | part11_table.tex"


/*=============================================================================
  PART 12 — ADVANCED OPTIONS: sortvar, title, tstat, merge, excel
  
  Covering: column reordering, merging tables, Excel formatting,
  mean + SD rows, storing in matrix, and the noaster option.
=============================================================================*/

di "=== PART 12: Advanced outreg2 Options ==="

* ── 12a: sortvar — custom row ordering ──────────────────────────────────────
/*
  By default, outreg2 shows variables in the order they appear in the model.
  sortvar() forces a specific ordering of coefficient rows.
  Variables not in sortvar() appear at the end.
*/

regress income_el income_bl treat hh_size hh_female_hh           ///
        hh_age_head hh_edu_head hh_land_owned i.district,        ///
        vce(cluster village_id)

outreg2 using "part12_advanced.xls",                           ///
    replace                                                     ///
    ctitle("(1) Custom Row Order")                             ///
    label nocons                                               ///
    keep(treat income_bl hh_size hh_female_hh hh_edu_head)    ///
    drop(*.district)                                           ///
    sortvar(treat income_bl hh_size hh_female_hh hh_edu_head)

/*
  Without sortvar: income_bl appears first (it was first in regression)
  With sortvar(treat ...): treat is forced to the top row
*/

* ── 12b: addstat — computed statistics ──────────────────────────────────────
/*
  addstat() can use:
  - e() scalars stored by the last estimation command
  - local macros
  - global macros
  - computed expressions
*/

regress income_el treat income_bl hh_size hh_female_hh           ///
        hh_age_head hh_edu_head hh_land_owned i.district,        ///
        vce(cluster village_id)

* Compute control group mean separately
summarize income_el if treat == 0
local ctrl_mean = r(mean)

outreg2 using "part12_advanced.xls",                           ///
    append                                                      ///
    ctitle("(2) With Control Mean")                            ///
    label nocons keep(treat income_bl)                        ///
    drop(*.district)                                           ///
    addstat("Control Group Mean", `ctrl_mean',                 ///
            "Adj. R-squared",  e(r2_a),                        ///
            "F-stat", e(F))                                    ///
    dec(2)

* ── 12c: Title row in the table ──────────────────────────────────────────────
regress income_el treat income_bl hh_size hh_female_hh           ///
        hh_age_head hh_edu_head hh_land_owned i.district,        ///
        vce(cluster village_id)

outreg2 using "part12_advanced.xls",                           ///
    append                                                      ///
    ctitle("(3) Titled Table")                                 ///
    label nocons keep(treat income_bl)                        ///
    drop(*.district)                                           ///
    title("Panel A: Income & Consumption Outcomes")            ///
    addtext("District FE","Yes")

* ── 12d: noaster — suppress significance stars ───────────────────────────────
/*
  Some journals require tables WITHOUT stars.
  Use noaster to suppress all significance symbols.
*/
regress income_el treat income_bl hh_size hh_female_hh           ///
        hh_age_head hh_edu_head hh_land_owned i.district,        ///
        vce(cluster village_id)

outreg2 using "part12_advanced.xls",                           ///
    append                                                      ///
    ctitle("(4) No Stars")                                     ///
    label nocons keep(treat income_bl)                        ///
    drop(*.district)                                           ///
    noaster

* ── 12e: noni — suppress number of observations ──────────────────────────────
outreg2 using "part12_advanced.xls",                           ///
    append                                                      ///
    ctitle("(5) No N displayed")                               ///
    label nocons keep(treat income_bl)                        ///
    drop(*.district)                                           ///
    noni

* ── 12f: nor2 — suppress R-squared ──────────────────────────────────────────
regress income_el treat income_bl hh_size hh_female_hh           ///
        hh_age_head hh_edu_head hh_land_owned i.district,        ///
        vce(cluster village_id)

outreg2 using "part12_advanced.xls",                           ///
    append                                                      ///
    ctitle("(6) No R-sq")                                      ///
    label nocons keep(treat income_bl)                        ///
    drop(*.district)                                           ///
    nor2

di "Table saved: part12_advanced.xls"


/*=============================================================================
  PART 13 — COMPLETE PUBLICATION-READY TABLE
  
  Pulling everything together: a complete Table 2 for an RCT paper —
  Treatment effects on multiple outcomes with full controls,
  clustered SEs, district FE, control means, and clean formatting.
=============================================================================*/

di "=== PART 13: Complete Publication-Ready Table ==="

capture erase "TABLE2_treatment_effects.xls"

* ── Outcome 1: Per-capita consumption ───────────────────────────────────────
regress pce_el treat pce_bl hh_size hh_female_hh                 ///
        hh_age_head hh_edu_head hh_land_owned i.district,        ///
        vce(cluster village_id)

summarize pce_el if treat == 0
local ctrl1 = round(r(mean), 1)
local n1    = e(N)

outreg2 using "TABLE2_treatment_effects.xls",                  ///
    replace                                                     ///
    ctitle("(1)", "PCE (BDT)")                                 ///
    label nocons keep(treat pce_bl)                            ///
    drop(*.district)                                           ///
    addstat("Control Mean", `ctrl1')                           ///
    addtext("District FE","Yes","Covariates","Yes")            ///
    nonotes                                                    ///
    dec(1) bdec(1) sdec(1)

* ── Outcome 2: Income ────────────────────────────────────────────────────────
regress income_el treat income_bl hh_size hh_female_hh           ///
        hh_age_head hh_edu_head hh_land_owned i.district,        ///
        vce(cluster village_id)

summarize income_el if treat == 0
local ctrl2 = round(r(mean), 1)

outreg2 using "TABLE2_treatment_effects.xls",                  ///
    append                                                      ///
    ctitle("(2)", "Income (BDT)")                              ///
    label nocons keep(treat income_bl)                         ///
    drop(*.district)                                           ///
    addstat("Control Mean", `ctrl2')                           ///
    addtext("District FE","Yes","Covariates","Yes")            ///
    nonotes                                                    ///
    dec(1) bdec(1) sdec(1)

* ── Outcome 3: Food expenditure ─────────────────────────────────────────────
regress food_exp_el treat food_exp_bl hh_size hh_female_hh       ///
        hh_age_head hh_edu_head hh_land_owned i.district,        ///
        vce(cluster village_id)

summarize food_exp_el if treat == 0
local ctrl3 = round(r(mean), 1)

outreg2 using "TABLE2_treatment_effects.xls",                  ///
    append                                                      ///
    ctitle("(3)", "Food Exp (BDT)")                            ///
    label nocons keep(treat food_exp_bl)                       ///
    drop(*.district)                                           ///
    addstat("Control Mean", `ctrl3')                           ///
    addtext("District FE","Yes","Covariates","Yes")            ///
    nonotes                                                    ///
    dec(1) bdec(1) sdec(1)

* ── Outcome 4: Days worked ───────────────────────────────────────────────────
regress days_work_el treat days_work_bl hh_size hh_female_hh     ///
        hh_age_head hh_edu_head hh_land_owned i.district,        ///
        vce(cluster village_id)

summarize days_work_el if treat == 0
local ctrl4 = round(r(mean), 2)

outreg2 using "TABLE2_treatment_effects.xls",                  ///
    append                                                      ///
    ctitle("(4)", "Days Worked")                               ///
    label nocons keep(treat days_work_bl)                      ///
    drop(*.district)                                           ///
    addstat("Control Mean", `ctrl4')                           ///
    addtext("District FE","Yes","Covariates","Yes")            ///
    nonotes                                                    ///
    dec(2)

* ── Outcome 5: Savings ───────────────────────────────────────────────────────
regress savings_el treat savings_bl hh_size hh_female_hh         ///
        hh_age_head hh_edu_head hh_land_owned i.district,        ///
        vce(cluster village_id)

summarize savings_el if treat == 0
local ctrl5 = round(r(mean), 1)

outreg2 using "TABLE2_treatment_effects.xls",                  ///
    append                                                      ///
    ctitle("(5)", "Savings (BDT)")                             ///
    label nocons keep(treat savings_bl)                        ///
    drop(*.district)                                           ///
    addstat("Control Mean", `ctrl5')                           ///
    addtext("District FE","Yes","Covariates","Yes")            ///
    nonotes                                                    ///
    dec(1)

* ── Outcome 6: Child schooling (LPM) ────────────────────────────────────────
regress child_school_el treat child_school_bl hh_size            ///
        hh_female_hh hh_edu_head hh_land_owned i.district,       ///
        vce(cluster village_id)

summarize child_school_el if treat == 0
local ctrl6 = round(r(mean), 3)

outreg2 using "TABLE2_treatment_effects.xls",                  ///
    append                                                      ///
    ctitle("(6)", "Child School")                              ///
    label nocons keep(treat child_school_bl)                   ///
    drop(*.district)                                           ///
    addstat("Control Mean", `ctrl6')                           ///
    addtext("District FE","Yes","Covariates","Yes")            ///
    nonotes                                                    ///
    dec(3) bdec(3) sdec(3)

* ── Outcome 7: Women's empowerment ──────────────────────────────────────────
regress women_emp_el treat women_emp_bl hh_size hh_female_hh     ///
        hh_age_head hh_edu_head hh_land_owned i.district,        ///
        vce(cluster village_id)

summarize women_emp_el if treat == 0
local ctrl7 = round(r(mean), 2)

outreg2 using "TABLE2_treatment_effects.xls",                  ///
    append                                                      ///
    ctitle("(7)", "Women Empower.")                            ///
    label nocons keep(treat women_emp_bl)                      ///
    drop(*.district)                                           ///
    addstat("Control Mean", `ctrl7')                           ///
    addtext("District FE","Yes","Covariates","Yes")            ///
    nonotes                                                    ///
    addnote("Notes: All specifications include district fixed effects and household",  ///
            "controls (HH size, female-headed, age and education of head, land owned).",  ///
            "Standard errors clustered at village level in parentheses.",              ///
            "ANCOVA specification: baseline outcome included as control.",             ///
            "*** p<0.01  ** p<0.05  * p<0.10")                 ///
    dec(2)

di "======================================================"
di "FINAL TABLE saved: TABLE2_treatment_effects.xls"
di "This is publication-ready Table 2 for an RCT paper."
di "======================================================"


/*=============================================================================
  PART 14 — COMMON PITFALLS & DEBUGGING TIPS
=============================================================================*/

di "=== PART 14: Common Pitfalls & Tips ==="

/*
  ┌──────────────────────────────────────────────────────────────────────────┐
  │ PITFALL 1: Forgetting replace/append                                     │
  │   If you run outreg2 twice with neither replace nor append,              │
  │   the second call will throw an error or overwrite silently.             │
  │   Rule: FIRST column → replace; ALL subsequent → append                  │
  └──────────────────────────────────────────────────────────────────────────┘
  
  ┌──────────────────────────────────────────────────────────────────────────┐
  │ PITFALL 2: Stale e() results                                             │
  │   outreg2 reads the e() results stored in Stata's memory.               │
  │   If you run a summarize, tabulate, or test BETWEEN regress and         │
  │   outreg2, e() may be overwritten.                                       │
  │   Rule: ALWAYS run outreg2 immediately after the estimation command.     │
  │                                                                          │
  │   BAD:                                                                   │
  │     regress y x                                                          │
  │     summarize y                     ← THIS CLEARS e()!                  │
  │     outreg2 using "file.xls"        ← wrong results                     │
  │                                                                          │
  │   GOOD:                                                                  │
  │     regress y x                                                          │
  │     outreg2 using "file.xls"        ← immediately after                  │
  │     summarize y                     ← summarize after                    │
  └──────────────────────────────────────────────────────────────────────────┘
  
  ┌──────────────────────────────────────────────────────────────────────────┐
  │ PITFALL 3: keep() and label mismatch                                     │
  │   keep() takes VARIABLE NAMES, not variable labels.                      │
  │   Even when label is specified, keep() uses the original var names.      │
  │   Use: keep(treat income_bl)  NOT  keep("Treatment" "Income BL")         │
  └──────────────────────────────────────────────────────────────────────────┘
  
  ┌──────────────────────────────────────────────────────────────────────────┐
  │ PITFALL 4: Factor variables in keep/drop                                 │
  │   If you use i.district in regression, the FE dummies are named         │
  │   2.district, 3.district (factor notation).                              │
  │   To drop them: drop(*.district)  — the wildcard * drops all levels.   │
  │   Alternatively: keep(treat income_bl) and don't mention district at all│
  └──────────────────────────────────────────────────────────────────────────┘
  
  ┌──────────────────────────────────────────────────────────────────────────┐
  │ PITFALL 5: File open in Excel                                            │
  │   If the .xls file is open in Excel, outreg2 cannot write to it         │
  │   and will error. Close the file first.                                  │
  └──────────────────────────────────────────────────────────────────────────┘
  
  ┌──────────────────────────────────────────────────────────────────────────┐
  │ PITFALL 6: append without replace first                                  │
  │   If the file doesn't exist yet and you use append, outreg2 errors.     │
  │   Rule: Always use replace for the very first model in a new file.      │
  └──────────────────────────────────────────────────────────────────────────┘
  
  ┌──────────────────────────────────────────────────────────────────────────┐
  │ PITFALL 7: Wrong decimal display for very large/small numbers           │
  │   BDT values in thousands will display oddly with dec(3).               │
  │   Use dec(0) or dec(1) for large monetary values.                       │
  │   Use dec(3) or dec(4) for proportions/indices.                         │
  └──────────────────────────────────────────────────────────────────────────┘
  
  ┌──────────────────────────────────────────────────────────────────────────┐
  │ USEFUL DEBUGGING COMMANDS:                                               │
  │                                                                          │
  │   ereturn list          → see all e() scalars after estimation          │
  │   return list           → see r() scalars after r-class commands        │
  │   help outreg2          → full option reference                         │
  │   which outreg2         → confirm outreg2 is installed                  │
  └──────────────────────────────────────────────────────────────────────────┘

  ┌──────────────────────────────────────────────────────────────────────────┐
  │ QUICK REFERENCE: Most-Used outreg2 Options                              │
  │                                                                          │
  │  File control:                                                           │
  │    replace             first model; creates new file                    │
  │    append              subsequent models; adds column                   │
  │    using "file.xls"    output filename                                  │
  │                                                                          │
  │  Column appearance:                                                      │
  │    ctitle("text")      column header                                    │
  │    label               use variable labels                              │
  │    nocons              hide constant                                    │
  │    keep(varlist)       show only these rows                             │
  │    drop(varlist)       hide these rows                                  │
  │    sortvar(varlist)    reorder coefficient rows                         │
  │                                                                          │
  │  Stats below coefficients:                                               │
  │    stats(coef se)      default: coef + SE                               │
  │    stats(coef tstat)   coef + t-statistic                               │
  │    stats(coef pval)    coef + p-value                                   │
  │                                                                          │
  │  Decimals:                                                               │
  │    dec(#)              both coef and SE                                 │
  │    bdec(#)             coef only                                        │
  │    sdec(#)             SE only                                          │
  │                                                                          │
  │  Stars:                                                                  │
  │    alpha(# # #)        significance thresholds                         │
  │    symbol(* ** ***)    corresponding symbols                            │
  │    noaster             no stars at all                                  │
  │                                                                          │
  │  Summary statistics:                                                     │
  │    addstat("lbl", val) custom numeric rows at bottom                   │
  │    addtext("lbl","val")custom text rows at bottom                      │
  │    addnote("text")     footnotes                                        │
  │    noni                hide N                                           │
  │    nor2                hide R-squared                                   │
  │                                                                          │
  │  Format:                                                                 │
  │    word / tex(frag)    Word or LaTeX output                             │
  │    eform               exponentiate coefs (OR, IRR, HR)                │
  │    title("text")       table title                                      │
  └──────────────────────────────────────────────────────────────────────────┘
*/


* ── Cleanup temporary files ──────────────────────────────────────────────────
capture erase "village_level.dta"

di ""
di "========================================================================="
di "  TUTORIAL COMPLETE — Files generated:"
di "  rct_hh_survey.dta          → 5,000-HH RCT dataset"
di "  part2_basic.xls            → simplest outreg2 output"
di "  part3_ols_income.xls       → multi-spec OLS table"
di "  part4_clustered_se.xls     → robust/clustered SE table"
di "  part5_fe.xls               → fixed effects table"
di "  part6_iv.xls               → IV/2SLS table"
di "  part7_binary.xls           → probit/logit/LPM table"
di "  part8_formatting.xls       → formatting options demo"
di "  part9_multioutcome.xls     → multi-outcome treatment table"
di "  part10_hte.xls             → heterogeneous treatment effects"
di "  part11_table.doc           → Word output"
di "  part11_table.tex           → LaTeX fragment output"
di "  part12_advanced.xls        → advanced options demo"
di "  TABLE2_treatment_effects.xls → FINAL publication-ready table"
di "  outreg2_tutorial.log       → session log"
di "========================================================================="

log close
